{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pkhemu",
  "version": "0.14.0",
  "identifier": "fyi.openpkx.pkhemu",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "pkhemu",
        "width": 960,
        "height": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 26
    },
    "macOS": {
      "frameworks": [
        "cores/melondsds_libretro.dylib",
        "cores/mupen64plus_next_libretro.dylib",
        "cores/azahar_libretro.dylib",
        "cores/dolphin_libretro.dylib",
        "cores/libMoltenVK.dylib"
      ],
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "10.15"
    },
    "iOS": {
      "minimumSystemVersion": "18.0"
    }
  }
}
