        {"id": "front-pic", "offset": "0x58", "length": 4, "type": "u32le", "name": "Front picture pointer", "confidence": "guess", "source": "rom:1d20091c4d936f5eb122db8780554dd0829ffb63", "note": "A pointer to LZ77-compressed graphics in every entry Imperium fills, the Egg too. That it's the front picture is a guess."}
